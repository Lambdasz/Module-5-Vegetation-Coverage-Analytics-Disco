{
  "$schema": "https://aerial-analytics.local/schemas/plugin.v1.json",
  "manifest_version": 1,

  "metadata": {
    "id": "vegetation-coverage-analytics",
    "name": "vegetation Coverage Analytics",
    "version": "1.0.0",
    "author": "VCA Team Disco",
    "license": "MIT",
    "description": "Provide analytics for vegetation coverage.",
    "category": "vegetation",
    "tags": ["analytics", "vegetation", "plot", "area"],
    "min_core_version": "0.1.0"
  },

  "runtime": {
    "type": "python",
    "min_python_version": "3.10",
    "entrypoint": "main.py",
    "dependencies_file": "requirements.txt",
    "healthcheck_flag": "--healthcheck"
  },

  "parameters": "parameters.json",
  "inputs": "inputs.json",
  "outputs": "outputs.json",

  "execution": {
    "timeout_seconds": 120,
    "concurrency": "sequential",
    "gpu": {
      "support": "none",
      "driver": null
    }
  }
}
